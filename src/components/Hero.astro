---
import { asset } from '../lib/asset';
---

<section class="hero" id="inici">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Psicologia · Creativitat · Talent</span>
      <h1>
        Desenvolupem el <em>talent</em> a través de la psicologia i la <strong>creativitat.</strong>
      </h1>
      <p>
        Acompanyem infants, adolescents i adults a descobrir el seu potencial, comprendre's millor i
        créixer amb confiança, emoció i sentit.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#calendari">Descobreix els nostres programes</a>
        <a class="btn btn-outline" href="#qui-som">Qui som</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <img src={asset('assets/images/hero-art.png')} alt="" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 42px 0 32px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 36% 64%;
    align-items: center;
    min-height: 560px;
  }

  .hero-copy {
    padding-right: 24px;
  }

  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    line-height: 1.08;
    font-size: clamp(44px, 5vw, 68px);
    margin: 18px 0 22px;
  }

  .hero h1 em {
    color: var(--green);
    font-style: normal;
  }

  .hero h1 strong {
    color: var(--pink);
    font-weight: 500;
  }

  .hero-copy p {
    font-size: 18px;
    color: var(--ink-soft);
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 28px;
  }

  .hero-visual {
    position: relative;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: 10% 5% 0 10%;
    background:
      radial-gradient(circle at 35% 45%, rgb(var(--glow-pink-rgb) / 0.18), transparent 35%),
      radial-gradient(circle at 70% 55%, rgb(var(--glow-yellow-rgb) / 0.18), transparent 32%);
    filter: blur(10px);
  }

  .hero-visual img {
    position: relative;
    width: 100%;
    mix-blend-mode: multiply;
  }

  @media (max-width: 1050px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: 760px;
    }

    .hero-visual {
      margin-top: 20px;
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding-top: 20px;
    }

    .hero-grid {
      min-height: auto;
    }

    .hero h1 {
      font-size: 43px;
    }

    .hero-copy p {
      font-size: 16px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-visual img {
      width: 125%;
      max-width: none;
      margin-left: -13%;
    }
  }
</style>
