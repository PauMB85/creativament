---
import InstagramLogo from '../icons/instagram-logo.svg';
import FacebookLogo from '../icons/facebook-logo.svg';
import YoutubeLogo from '../icons/youtube-logo.svg';
import Envelope from '../icons/envelope.svg';
import { asset, route } from '../lib/asset';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <img class="footer-logo" src={asset('assets/images/logo.png')} alt="Creativament" />
    <div class="footer-links">
      <a href={route('avis-legal/')}>Avís legal</a>
      <a href={route('politica-de-privacitat/')}>Política de privacitat</a>
      <a href={route('politica-de-cookies/')}>Política de cookies</a>
    </div>
    <div class="socials">
      <span>Segueix-nos</span>
      <a href="#" aria-label="Instagram"><InstagramLogo aria-hidden="true" /></a>
      <a href="#" aria-label="Facebook"><FacebookLogo aria-hidden="true" /></a>
      <a href="#" aria-label="YouTube"><YoutubeLogo aria-hidden="true" /></a>
      <a href="mailto:hola@creativament.cat" aria-label="Correu">
        <Envelope aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 32px 0;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 30px;
  }

  .footer-logo {
    width: 180px;
    height: 78px;
    object-fit: cover;
    object-position: left top;
  }

  .footer-links {
    display: flex;
    gap: 18px;
    justify-content: center;
    font-size: 11px;
    text-transform: uppercase;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
  }

  .socials a {
    display: flex;
    color: var(--ink);
    transition: 0.2s;
  }

  .socials a:hover {
    color: var(--pink);
  }

  .socials svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  @media (max-width: 1050px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-logo {
      margin: auto;
    }

    .footer-links,
    .socials {
      justify-content: center;
    }
  }

  @media (max-width: 650px) {
    .footer-links,
    .socials {
      flex-wrap: wrap;
    }
  }
</style>
